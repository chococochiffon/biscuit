{
    "version": 2,
    "children": [
        {
            "type": "section",
            "props": {},
            "styles": { "paddingTop": "96px", "paddingBottom": "96px", "backgroundColor": "theme:light", "textAlign": "center" },
            "children": [
                {
                    "type": "heading",
                    "props": { "text": "{{site_title}}", "level": 1 },
                    "styles": { "fontSize": "44px", "fontWeight": "700" },
                    "responsive": { "mobile": { "fontSize": "30px" } },
                    "layout": { "desktop": { "x": 10, "y": 0, "w": 80 } }
                },
                {
                    "type": "text",
                    "props": { "html": "<p>{{site_description}}</p>" },
                    "styles": { "color": "#6c757d", "fontSize": "18px" },
                    "layout": { "desktop": { "x": 15, "y": 80, "w": 70 } }
                }
            ]
        },
        {
            "type": "section",
            "props": {},
            "styles": { "paddingTop": "48px", "paddingBottom": "64px" },
            "children": [
                {
                    "type": "heading",
                    "props": { "text": "{{latest_articles}}", "level": 2 },
                    "styles": { "textAlign": "center" },
                    "layout": { "desktop": { "x": 10, "y": 0, "w": 80 } }
                },
                {
                    "type": "article-list",
                    "props": { "limit": 6 },
                    "styles": {},
                    "layout": { "desktop": { "x": 5, "y": 64, "w": 90 } }
                }
            ]
        }
    ]
}
