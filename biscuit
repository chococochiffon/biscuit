#!/usr/bin/env bash
#
# Biscuit の運用のコマンド(ホスト側)。インストールのあとに、Biscuit を置いたディレクトリで動かす。
#
#   ./biscuit status      版・URL・コンテナ・データベースの状態を表示する
#   ./biscuit doctor      動作に問題がないかを診断する(問題があれば終了コード 1)
#   ./biscuit stop        コンテナをすべて止める(データは残る。止めたままなら、PC・Docker を起動し直しても動かない)
#   ./biscuit start       止めたコンテナを起動する
#   ./biscuit backup      データベース・画像・.env をバックアップする(新しい 7 個を残す)
#   ./biscuit backup list           いまあるバックアップを表示する
#   ./biscuit backup copy <名前> <ディレクトリ>  バックアップをホストのディレクトリに写す
#   ./biscuit restore <名前かファイル>  バックアップからデータベースと画像を戻す(先にいまの状態をバックアップする)
#   ./biscuit update      新しい版に更新する(同じメジャー版の最新。--version v2.0.0 で版を指定、--check で確かめるだけ)
#   ./biscuit update --from v1.0.0   手で新しいタグに切り替えたあと、残りの更新をする(./biscuit がない v1.0.0 からの更新)
#   ./biscuit install     インストーラーを起動する(./install.sh と同じ)
#   ./biscuit help        この説明を表示する
#
# 役割: Docker・git を扱う処理と、ホストから見える状態の確認を受け持つ。Biscuit の中の処理(診断・状態など)は
# app コンテナの中の php artisan biscuit:* が行う。パスワードなどの秘密の値は、画面にもログにも出さない。

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
# ホスト側のログ(*.log は git で除外)
HOST_LOG="$ROOT/biscuit.log"
# shellcheck source=docker/production/lib.sh
. "$ROOT/docker/production/lib.sh"

# バックアップの置き場所(app コンテナの中から見たパス)
BACKUP_DIR="storage/app/private/backups"
# バックアップの名前の形(ほかのファイルを読ませない。BackupService::NAME_PATTERN と同じ形)
BACKUP_NAME_PATTERN='^biscuit-[0-9]{8}-[0-9]{6}-[a-z-]+\.tar\.gz$'
# 版のタグ(v1.2.3 の形だけ。v1.2.3-rc1 などは使わない)
VERSION_TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+$'

usage() {
  sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'
}

# インストールを終えていなければ、インストーラーへ案内して止める
require_installed() {
  if [ ! -f "$APP/.env" ] || ! is_installed; then
    fail "Biscuit はまだインストールしていません。./install.sh でインストールしてください。"
  fi
}

# いまの版(git のタグ)。タグの上になければ、コミットを表示する
git_version() {
  git -C "$1" describe --tags --exact-match 2>/dev/null || printf '%s(タグではありません)' "$(git -C "$1" rev-parse --short HEAD 2>/dev/null || echo '?')"
}

# 結果の 1 行(ok・warn・ng と、項目と、詳しく)
report() {
  local result="$1" label="$2" detail="${3:-}"
  case "$result" in
    ok) printf '  \033[32m✔\033[0m %s' "$label" ;;
    warn) printf '  \033[33m!\033[0m %s' "$label" ;;
    *) printf '  \033[31m✘\033[0m %s' "$label" ;;
  esac
  [ -n "$detail" ] && printf '  \033[2m%s\033[0m' "$detail"
  printf '\n'
}

# ホストから見える状態の診断(Docker のコンテナ・git の作業ツリー・ディスク)。必須の問題があれば 1 を返す
host_checks() {
  local failed=0 service state

  printf '\nホスト\n'
  for service in db app web front scheduler; do
    state="$(compose ps -a --format '{{.State}}' "$service" 2>/dev/null | head -n 1)"
    if [ "$state" = "running" ]; then
      report ok "コンテナ $service が動いている"
    else
      report ng "コンテナ $service が動いている" "${state:-ありません}(./biscuit start で起動できます)"
      failed=1
    fi
  done

  if [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    report ok "Biscuit のファイルを書き換えていない" "$(git_version "$ROOT")"
  else
    report warn "Biscuit のファイルを書き換えていない" "変更があります(更新のときに失われることがあります)"
  fi

  if [ -d "$ROOT/frontend/chococo/.git" ]; then
    report ok "公開側(chococo)がある" "$(git_version "$ROOT/frontend/chococo")"
  else
    report ng "公開側(chococo)がある" "frontend/chococo がありません"
    failed=1
  fi

  local free_kb
  free_kb="$(df -Pk "$ROOT" | awk 'NR == 2 { print $4 }')"
  if [ "${free_kb:-0}" -ge 2097152 ]; then
    report ok "ディスクの空きが 2GB 以上ある" "$((free_kb / 1024 / 1024))GB"
  else
    report warn "ディスクの空きが 2GB 以上ある" "$((free_kb / 1024))MB(更新のビルド・バックアップに足りないことがあります)"
  fi

  return "$failed"
}

cmd_status() {
  require_installed
  printf '\n  Biscuit %s\n\n' "$(biscuit_version)"
  printf '  サイト:     %s\n  管理画面:   %s/admin\n' "$(front_url)" "$(admin_url)"
  printf '  biscuit:    %s\n  chococo:    %s\n\n' "$(git_version "$ROOT")" "$(git_version "$ROOT/frontend/chococo" 2>/dev/null || echo '-')"
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
  printf '\n'
  in_app php artisan biscuit:status
}

cmd_doctor() {
  require_installed
  local failed=0

  printf '\n  Biscuit Doctor\n'
  host_checks || failed=1

  printf '\nBiscuit\n'
  if [ -n "$(compose ps -q --status running app 2>/dev/null)" ]; then
    in_app php artisan biscuit:doctor || failed=1
  else
    report ng "app コンテナが動いていないため、Biscuit の中を診断できません"
    failed=1
  fi

  printf '\n'
  if [ "$failed" -eq 0 ]; then
    info "問題は見つかりませんでした(警告(!)は、本番で公開する前に確かめてください)。"
  else
    warn "問題があります。✘ の項目を確かめてください。"
  fi
  log "doctor failed=$failed"
  return "$failed"
}

cmd_stop() {
  require_installed
  acquire_lock
  info "コンテナをすべて止めます"
  compose stop >>"$HOST_LOG" 2>&1 || fail "止められませんでした(ログ: $HOST_LOG)。"
  log "stopped"
  info "止めました。データベース・画像・設定は残っています。./biscuit start で起動します。"
}

cmd_start() {
  require_installed
  acquire_lock
  info "コンテナを起動します"
  compose up -d db app web front scheduler >>"$HOST_LOG" 2>&1 || fail "起動できませんでした(ログ: $HOST_LOG)。"
  wait_for_db || fail "データベースが起動しませんでした(ログ: $HOST_LOG)。./biscuit doctor で確かめてください。"
  log "started"
  info "起動しました。"
  printf '\n  サイト:     %s\n  管理画面:   %s/admin\n\n' "$(front_url)" "$(admin_url)"
}

cmd_backup() {
  require_installed
  local action="${1:-create}"

  case "$action" in
    create)
      acquire_lock
      info "バックアップを作ります(データベース・画像・.env)"
      in_app php artisan biscuit:backup --reason=manual || fail "バックアップを作れませんでした。"
      log "backup created"
      info "サーバーが壊れたときに備えて、./biscuit backup copy で別の場所にも写してください。"
      ;;
    list)
      in_app php artisan biscuit:backup --list
      ;;
    copy)
      local name="${2:-}" dest="${3:-}"
      [ -n "$name" ] && [ -n "$dest" ] || fail "使い方: ./biscuit backup copy <名前(./biscuit backup list の「ファイル」)> <写す先のディレクトリ>"
      # 決まった形の名前だけを受け付ける(ほかのファイルを読ませない)
      [[ "$name" =~ $BACKUP_NAME_PATTERN ]] || fail "バックアップの名前ではありません: $name"
      [ -d "$dest" ] || fail "写す先のディレクトリがありません: $dest"
      [ ! -e "$dest/$name" ] || fail "写す先に同じ名前のファイルがあります: $dest/$name"
      # バックアップは www-data だけが読めるため、コンテナの中で読んで写す。秘密の値が入るため、写したファイルも本人だけが読めるようにする
      if ! (umask 077 && in_app cat "$BACKUP_DIR/$name" >"$dest/$name"); then
        rm -f "$dest/$name"
        fail "写せませんでした($name が見つからないか、読めません)。"
      fi
      log "backup copied $name"
      info "$dest/$name に写しました(.env のパスワード・APP_KEY が入っているため、人に見られない場所に置いてください)。"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

# yes と入力されなければ止める
confirm_or_abort() {
  local answer
  read -r -p "  続けるには yes と入力してください: " answer
  [ "$answer" = "yes" ] || fail "やめました。"
}

# restore・update の前の準備: スケジューラーを止め(作業のあいだに毎日のバックアップなどを動かさない)、いまの状態をバックアップして
# (名前は SAFETY_BACKUP に入れる)、メンテナンスモードにする。途中で止まっても finish_maintenance(EXIT の trap)が元に戻す
SAFETY_BACKUP=""
IN_MAINTENANCE=0
SCHEDULER_STOPPED=0

begin_maintenance() {
  local reason="$1"
  shift
  trap finish_maintenance EXIT

  info "スケジューラーを止めます"
  compose stop scheduler >/dev/null 2>&1 || true
  SCHEDULER_STOPPED=1

  info "いまの状態をバックアップします"
  SAFETY_BACKUP="$(in_app php artisan biscuit:backup --reason="$reason" "$@" --json </dev/null | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')"
  [ -n "$SAFETY_BACKUP" ] || fail "いまの状態をバックアップできなかったため、何も変えていません。"
  info "作業の前のバックアップ: $SAFETY_BACKUP"

  in_app php artisan down --retry=60 </dev/null >/dev/null || fail "メンテナンスモードにできませんでした。"
  IN_MAINTENANCE=1
}

# 元の状態にも戻せなかったとき: 壊れたサイトを見せず、壊れた状態で毎日のバックアップを動かさない(古い正常なバックアップを
# 押し出さない)よう、メンテナンスモードもスケジューラーの停止もそのままにして止める
fail_in_maintenance() {
  IN_MAINTENANCE=0
  SCHEDULER_STOPPED=0
  fail "$1"
}

finish_maintenance() {
  if [ "$IN_MAINTENANCE" -eq 1 ]; then
    in_app php artisan up </dev/null >/dev/null 2>&1 || warn "メンテナンスモードを解除できませんでした。./biscuit doctor で確かめてください。"
    IN_MAINTENANCE=0
  fi
  if [ "$SCHEDULER_STOPPED" -eq 1 ]; then
    compose up -d scheduler >/dev/null 2>&1 || true
    SCHEDULER_STOPPED=0
  fi
  rm -rf "$LOCK_DIR"
}

cmd_restore() {
  require_installed
  local target="" yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      *) target="$arg" ;;
    esac
  done
  [ -n "$target" ] || fail "使い方: ./biscuit restore <名前(./biscuit backup list の「ファイル」)か、ホストのバックアップのファイル> [--yes]"

  acquire_lock

  local name
  name="$(basename "$target")"
  [[ "$name" =~ $BACKUP_NAME_PATTERN ]] || fail "バックアップの名前ではありません: $name"

  # ホストのファイル(別のサーバーから写したものなど)は、コンテナの中のバックアップの置き場所に写してから使う
  if [ -f "$target" ]; then
    if in_app test -e "$BACKUP_DIR/$name" </dev/null; then
      info "$name はすでにバックアップの置き場所にあるため、それを使います"
    else
      info "$target をバックアップの置き場所に写します"
      # パスはコンテナの中の sh に引数で渡す(ホスト側で展開しない)
      # shellcheck disable=SC2016
      in_app sh -c 'umask 077 && mkdir -p "$1" && cat >"$1/$2"' sh "$BACKUP_DIR" "$name" <"$target" || fail "$target を写せませんでした。"
    fi
  fi

  info "$name を確かめます"
  # docker compose exec は標準入力を読むため、確認の入力を飲み込まないよう切る
  in_app php artisan biscuit:restore "$name" --check </dev/null || fail "$name からは戻せません。"

  if [ "$yes" -ne 1 ]; then
    printf '\n  いまのデータベースと画像を、%s の内容にすべて入れ替えます(.env は戻しません)。\n' "$name"
    printf '  先にいまの状態をバックアップし、戻すあいだはサイトをメンテナンスモードにします。\n\n'
    confirm_or_abort
  fi

  log "restore start $name"
  # 戻す対象がいちばん古いバックアップでも消さないよう、古いものは消さない
  begin_maintenance pre-restore --no-prune
  local before="$SAFETY_BACKUP"

  info "$name から戻します"
  if ! in_app php artisan biscuit:restore "$name" --force </dev/null; then
    warn "戻せませんでした。リストアの前の状態($before)に戻します。"
    log "restore failed $name, rollback to $before"
    in_app php artisan biscuit:restore "$before" --force </dev/null \
      || fail_in_maintenance "リストアの前の状態にも戻せませんでした。./biscuit restore $before で、もう一度戻してください(サイトはメンテナンスモードのまま、スケジューラーは止めたままです)。"
    fail "$name からは戻せませんでした(リストアの前の状態に戻しました)。"
  fi

  finish_maintenance
  log "restore done $name"
  info "$name から戻しました。うまく戻っていなければ ./biscuit restore $before で、戻す前の状態にできます。"
}

# リモートにある版のタグ(古い順)
remote_version_tags() {
  git -C "$1" ls-remote --tags --refs origin 'v*' 2>/dev/null | sed 's|.*refs/tags/||' | grep -E "$VERSION_TAG_PATTERN" | sort -V
}

# 1 つ目の版が 2 つ目より新しいか
version_greater() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

major_of() {
  printf '%s' "${1#v}" | cut -d. -f1
}

# biscuit と chococo を、指定した版のタグに切り替える
checkout_version() {
  local tag="$1"
  git -C "$ROOT" fetch -q origin "refs/tags/$tag:refs/tags/$tag" &&
    git -C "$ROOT" -c advice.detachedHead=false checkout -q "$tag" &&
    git -C "$CHOCOCO_DIR" fetch -q --depth 1 origin "refs/tags/$tag:refs/tags/$tag" &&
    git -C "$CHOCOCO_DIR" -c advice.detachedHead=false checkout -q "$tag"
}

# いまのソースで、イメージ・PHP の依存関係・管理画面の CSS と JS を作り直し、サービスを起動し直す(install.sh と同じ手順)
rebuild_and_start() {
  info "イメージを作り直します(数分かかります)"
  compose build app scheduler front >>"$HOST_LOG" 2>&1 || return 1
  info "PHP の依存関係を入れます"
  install_php_dependencies >>"$HOST_LOG" 2>&1 || return 1
  info "管理画面の CSS・JS をビルドします"
  build_admin_assets >>"$HOST_LOG" 2>&1 || return 1
  info "サービスを起動し直します"
  compose up -d db app web front >>"$HOST_LOG" 2>&1 || return 1
  wait_for_db || return 1
}

# マイグレーションと、設定・ルート・ビューのキャッシュの作り直し
migrate_and_optimize() {
  info "データベースをいまのソースの版に合わせます(マイグレーション)"
  in_app php artisan migrate --force </dev/null || return 1
  in_app php artisan optimize:clear </dev/null >>"$HOST_LOG" 2>&1 || return 1
  if [ "$(env_value APP_ENV)" = "production" ]; then
    in_app php artisan optimize </dev/null >>"$HOST_LOG" 2>&1 || return 1
  fi
}

# 自動で更新できるソースか(biscuit・chococo のファイルを書き換えていない)
require_clean_sources() {
  [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ] || fail "Biscuit のファイルを書き換えているため、更新できません(git -C $ROOT status で変更を確かめてください)。"
  [ -d "$CHOCOCO_DIR/.git" ] || fail "公開側(frontend/chococo)がありません。"
  [ -z "$(git -C "$CHOCOCO_DIR" status --porcelain --untracked-files=no)" ] || fail "公開側(frontend/chococo)のファイルを書き換えているため、更新できません。"
}

# 更新先の版を選ぶ($2 を指定したときはその版。なければ $1 と同じメジャー版の最新。メジャー版が上がるもの(Upgrade)は、
# リリースノートを読んでから --version で選んでもらう)。$3 はリモートの版のタグの一覧
select_update_target() {
  local current="$1" requested="$2" tags="$3" target
  if [ -n "$requested" ]; then
    target="v${requested#v}"
    printf '%s\n' "$tags" | grep -qx "$target" || fail "$target という版はありません。"
  else
    target="$(printf '%s\n' "$tags" | awk -v major="$(major_of "$current")" -F. '{ m = $1; sub(/^v/, "", m) } m == major' | tail -n 1)"
  fi
  printf '%s' "${target:-$current}"
}

cmd_update() {
  require_installed
  local requested="" from="" check_only=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) requested="${2:-}"; shift ;;
      --version=*) requested="${1#--version=}" ;;
      --from) from="${2:-}"; shift ;;
      --from=*) from="${1#--from=}" ;;
      --check) check_only=1 ;;
      --yes|-y) yes=1 ;;
      *) fail "知らないオプションです: $1(./biscuit help)" ;;
    esac
    shift
  done

  acquire_lock

  # いまの版(タグの上にいて、ファイルを書き換えていないときだけ、自動で更新できる)
  local current head
  head="$(git -C "$ROOT" describe --tags --exact-match 2>/dev/null || true)"
  [[ "$head" =~ $VERSION_TAG_PATTERN ]] || fail "いまのソースが版のタグの上にないため、自動では更新できません(git -C $ROOT status で確かめてください)。"
  current="$head"
  if [ -n "$from" ]; then
    # 手で新しいタグに切り替えたあと: いま動いているのは --from の版で、更新先はいまのタグ(失敗したら --from の版に戻す)
    current="v${from#v}"
    # 形が違うときも、タグがないときも止める
    # shellcheck disable=SC2015
    [[ "$current" =~ $VERSION_TAG_PATTERN ]] && git -C "$ROOT" rev-parse -q --verify "refs/tags/$current" >/dev/null || fail "--from の $current という版のタグがありません。"
    [ -z "$requested" ] || fail "--from と --version は一緒に使えません(--from のときは、いまのタグ $head に更新します)。"
    requested="$head"
  fi
  require_clean_sources

  info "新しい版を確かめます(いまは $current)"
  local tags target latest
  tags="$(remote_version_tags "$ROOT")"
  [ -n "$tags" ] || fail "版の一覧を取得できませんでした(ネットワークと git -C $ROOT remote -v を確かめてください)。"
  latest="$(printf '%s\n' "$tags" | tail -n 1)"
  target="$(select_update_target "$current" "$requested" "$tags")" || exit 1

  if [ "$target" = "$current" ]; then
    info "最新の版($current)を使っています。"
    if version_greater "$latest" "$current"; then
      warn "メジャー版が上がる $latest が出ています。リリースノートで変更点を確かめてから ./biscuit update --version $latest で更新してください。"
    fi
    return 0
  fi
  version_greater "$target" "$current" || fail "$target は今の版($current)より古いため、更新できません(前の状態に戻すときは ./biscuit restore を使ってください)。"
  remote_version_tags "$CHOCOCO_DIR" | grep -qx "$target" || fail "公開側(chococo)に $target がまだありません。しばらくしてから、もう一度お試しください。"

  printf '\n  %s → %s\n' "$current" "$target"
  [ "$(major_of "$target")" != "$(major_of "$current")" ] && warn "メジャー版が上がります。リリースノートで、互換性のない変更と必要な作業を確かめてください。"
  printf '  リリースノート: https://github.com/%s/releases/tag/%s\n\n' "$(env_value BISCUIT_UPDATE_REPOSITORY | grep . || echo chococochiffon/biscuit)" "$target"
  [ "$check_only" -eq 1 ] && return 0

  info "更新の前に、診断します"
  # --from のときはソースが先に新しくなっているため、未実行のマイグレーションは判定に使わない(このあと流す)
  local ignore=()
  [ -n "$from" ] && ignore=(--ignore=migrations)
  if ! in_app php artisan biscuit:doctor --offline ${ignore[@]+"${ignore[@]}"} </dev/null >/dev/null; then
    fail "診断で問題(✘)が見つかったため、更新しません。./biscuit doctor で確かめてください。"
  fi

  if [ "$yes" -ne 1 ]; then
    printf '  更新のあいだ(数分〜十数分)は、サイトをメンテナンスモードにします。先にバックアップを作り、失敗したら元に戻します。\n\n'
    confirm_or_abort
  fi

  log "update start $current -> $target"
  begin_maintenance pre-update
  local backup="$SAFETY_BACKUP"

  info "$target のソースに切り替えます"
  if checkout_version "$target" && rebuild_and_start && migrate_and_optimize; then
    finish_maintenance
    log "update done $current -> $target"
    info "$target に更新しました。"
    printf '\n'
    in_app php artisan biscuit:doctor --offline </dev/null || warn "更新のあとの診断で問題が見つかりました。✘ の項目を確かめてください。"
    return 0
  fi

  warn "更新できませんでした($(basename "$HOST_LOG") を確かめてください)。$current と更新の前のバックアップに戻します。"
  log "update failed $current -> $target, rollback"
  if checkout_version "$current" && rebuild_and_start && in_app php artisan biscuit:restore "$backup" --force </dev/null && migrate_and_optimize; then
    fail "$target には更新できませんでした($current に戻しました)。"
  fi
  fail_in_maintenance "元の版にも戻せませんでした。git -C $ROOT checkout $current のあと ./biscuit restore $backup で戻してください(サイトはメンテナンスモードのまま、スケジューラーは止めたままです)。"
}

main() {
  local command="${1:-help}"
  [ $# -gt 0 ] && shift

  case "$command" in
    status) check_requirements >/dev/null; cmd_status ;;
    doctor) check_requirements >/dev/null; cmd_doctor ;;
    stop) check_requirements >/dev/null; cmd_stop ;;
    start) check_requirements >/dev/null; cmd_start ;;
    backup) check_requirements >/dev/null; cmd_backup "$@" ;;
    restore) check_requirements >/dev/null; cmd_restore "$@" ;;
    update) check_requirements >/dev/null; cmd_update "$@" ;;
    install) exec "$ROOT/install.sh" "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

